// SELF data model.
// Plain-language guide: docs/PLAN.md → "Data model". Each phase adds models here.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// Identity (owned by Better Auth: keep these field names as-is)
// ─────────────────────────────────────────────────────────────

model User {
  id                 String                  @id @default(cuid())
  name               String
  email              String                  @unique
  emailVerified      Boolean                 @default(false)
  image              String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  sessions           Session[]
  accounts           Account[]
  profile            Profile?
  hubs               Hub[]
  agentThreads       AgentThread[]
  agentRuns          AgentRun[]
  memberships        HubMember[]
  signalsSent        Signal[]                @relation("SignalFrom")
  signalsReceived    Signal[]                @relation("SignalTo")
  partner            Partner?
  simulationsStarted Simulation[]            @relation("SimulationsStarted")
  simulationSeats    SimulationParticipant[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ─────────────────────────────────────────────────────────────
// The SELF person. One per user. Auth tables stay about login;
// everything about who someone is lives here.
// ─────────────────────────────────────────────────────────────

enum Role {
  BUILDER
  BACKER
  PARTNER
  MENTOR
  ADMIN
}

model Profile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  roles    Role[]
  headline String? // one line: "Ex-supply-chain lead building in food waste"
  location String?

  // Builder reflection. Powers the personal agent (Phase 9).
  beliefs        String? // what they believe that most people don't
  workStyle      String? // how they work when it's going well
  buildingToward String? // the long arc, not the product
  strengths      String?
  gaps           String? // where they need other people
  decisionStyle  String? // how they make hard calls

  // Mentor / backer / partner specifics (short, optional).
  focusAreas String[] // mentor + backer focus, e.g. ["Climate", "Hardware"]
  mentorNote String?
  mentorOpen Boolean  @default(true) // mentor is taking new requests

  // Personal agent (Phase 9). `persona` is exactly what the agent is given;
  // the person can always read and edit it. Simulations need explicit opt-in.
  persona          String?
  personaUpdatedAt DateTime?
  simOptIn         Boolean   @default(false)
  simOptInAt       DateTime?
  backerNote       String? // what they back. Never amounts or terms.
  partnerOrgName   String? // linked to a Partner record in Phase 5

  // Contact details. Only ever revealed through an ACCEPTED Signal
  // (Phase 4+). Never select these fields for general UI.
  contactEmail String?
  contactLink  String?

  onboardingStep Int       @default(0) // resume point for the flow
  onboardedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// ─────────────────────────────────────────────────────────────
// Project Hubs: one idea each.
// ─────────────────────────────────────────────────────────────

enum HubStage {
  IDEA // raw idea, no thesis yet
  THESIS // thesis saved
  PLAN // game plan exists (Phase 3)
  BUILDING
  LAUNCHED
}

model Hub {
  id       String   @id @default(cuid())
  number   Int      @unique @default(autoincrement()) // shown as "HUB 03"
  slug     String   @unique
  ownerId  String
  owner    User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name     String
  oneLiner String?
  rawIdea  String // the thought it started from, kept for reference
  stage    HubStage @default(IDEA)

  // Cover: generated type-art (layout/tone override the name-based default)
  // or an uploaded image.
  coverLayout   String? // "initial" | "stack" | "repeat" | "index"
  coverTone     String? // "raised" | "bone" | "signal"
  coverImageUrl String?

  // Backer discovery (Phase 6). Off by default; the owner opts in.
  // Only signed-in BACKERs see discoverable hubs, and only a teaser.
  discoverable   Boolean   @default(false)
  discoverableAt DateTime?
  sector         String? // one of FOCUS_AREAS, for backer filters
  backerAsk      String? // what help they want from a backer. Never amounts or terms.

  thesis          Thesis?
  thesisRevisions ThesisRevision[]
  agentThreads    AgentThread[]
  agentRuns       AgentRun[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  planSteps       PlanStep[]
  members         HubMember[]
  roleOpenings    RoleOpening[]
  signals         Signal[]
  gtmWorkspace    GtmWorkspace?
  simulations     Simulation[]

  @@index([ownerId])
}

/// The current core thesis. Revisions keep history.
model Thesis {
  id            String   @id @default(cuid())
  hubId         String   @unique
  hub           Hub      @relation(fields: [hubId], references: [id], onDelete: Cascade)
  statement     String // one or two sentences: the whole bet
  problem       String
  audience      String // who it's for
  whyNow        String
  whyUs         String // why this builder
  contrarian    String // what they believe that others don't
  openQuestions String[] // what's still weak, from the last agent pass
  updatedAt     DateTime @updatedAt
}

enum RevisionSource {
  AGENT // drafted in the thesis dialogue
  EDIT // edited by hand
}

model ThesisRevision {
  id        String         @id @default(cuid())
  hubId     String
  hub       Hub            @relation(fields: [hubId], references: [id], onDelete: Cascade)
  source    RevisionSource
  snapshot  Json // the Thesis fields at that moment
  createdAt DateTime       @default(now())

  @@index([hubId, createdAt])
}

// ─────────────────────────────────────────────────────────────
// Agents: conversations and usage. Prompts live in src/agents/.
// ─────────────────────────────────────────────────────────────

model AgentThread {
  id        String         @id @default(cuid())
  kind      String // "thesis" now; hub agents in Phase 10
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  hubId     String?
  hub       Hub?           @relation(fields: [hubId], references: [id], onDelete: Cascade)
  messages  AgentMessage[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([hubId, kind])
}

enum MessageRole {
  USER
  AGENT
}

model AgentMessage {
  id        String      @id @default(cuid())
  threadId  String
  thread    AgentThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  role      MessageRole
  text      String // human-readable version
  data      Json? // structured output, when the agent returned some
  createdAt DateTime    @default(now())

  @@index([threadId, createdAt])
}

enum RunStatus {
  OK
  DEMO // no API key: canned output, no cost
  CAPPED // refused before calling: over the daily cap
  REFUSED // model declined
  ERROR
}

/// One row per agent call. Drives cost caps and the admin cost view.
model AgentRun {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  hubId           String?
  hub             Hub?      @relation(fields: [hubId], references: [id], onDelete: SetNull)
  purpose         String // e.g. "thesis.questions"
  model           String
  status          RunStatus
  inputTokens     Int       @default(0)
  outputTokens    Int       @default(0)
  cacheReadTokens Int       @default(0)
  durationMs      Int       @default(0)
  error           String?
  createdAt       DateTime  @default(now())

  @@index([userId, createdAt])
}

// ─────────────────────────────────────────────────────────────
// Game plan: staged steps from idea to launch (Phase 3).
// ─────────────────────────────────────────────────────────────

enum PlanStage {
  VALIDATE // prove the problem and the customer
  SETUP // company, team, money, paperwork
  BUILD // make the first real version
  LAUNCH // get it in front of customers
}

/// What a step needs from outside the builder. Each maps to a connection
/// area (src/lib/needs.ts): co-founders (Phase 4), partner directory
/// categories (Phase 5), backers (Phase 6), mentors (Phase 7).
enum NeedTag {
  COFOUNDER
  SUPPLIER
  LEGAL
  FUNDING
  MARKETING
  GTM
  WEBSITE
  MENTOR
}

enum StepSource {
  AGENT
  MANUAL
}

model PlanStep {
  id           String        @id @default(cuid())
  hubId        String
  hub          Hub           @relation(fields: [hubId], references: [id], onDelete: Cascade)
  stage        PlanStage
  position     Int // order within the stage, 0-based
  title        String
  detail       String?
  needs        NeedTag[]
  source       StepSource    @default(MANUAL)
  doneAt       DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  roleOpenings RoleOpening[]
  signals      Signal[]

  @@index([hubId, stage, position])
}

// ─────────────────────────────────────────────────────────────
// Team (Phase 4): the owner plus people who joined through an
// accepted ROLE_INTEREST signal.
// ─────────────────────────────────────────────────────────────

model HubMember {
  id       String   @id @default(cuid())
  hubId    String
  hub      Hub      @relation(fields: [hubId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     String // the role title they joined for
  joinedAt DateTime @default(now())

  @@unique([hubId, userId])
}

enum RoleStatus {
  OPEN
  FILLED
  CLOSED
}

/// A role a hub is looking for. Posting one makes the hub's name, one-liner
/// and thesis statement visible to other builders browsing roles.
model RoleOpening {
  id          String     @id @default(cuid())
  hubId       String
  hub         Hub        @relation(fields: [hubId], references: [id], onDelete: Cascade)
  planStepId  String? // the game-plan step this role serves, if any
  planStep    PlanStep?  @relation(fields: [planStepId], references: [id], onDelete: SetNull)
  title       String // "Technical co-founder"
  description String
  commitment  String // "Co-founder", "Part-time", "Advisor"…
  skills      String[]
  status      RoleStatus @default(OPEN)
  signals     Signal[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([status, createdAt])
}

// ─────────────────────────────────────────────────────────────
// Signals: every "can we connect?" in SELF. See CLAUDE.md.
// Contact details are only ever revealed between the two people
// on an ACCEPTED signal (src/lib/signals.ts enforces this).
// ─────────────────────────────────────────────────────────────

enum SignalKind {
  ROLE_INTEREST // builder → hub owner, about a role opening (Phase 4)
  BACKER_INTEREST // backer → hub owner. Interest only, never money (Phase 6)
  MENTOR_REQUEST // hub owner → mentor (Phase 7)
  PARTNER_INTRO // hub owner → partner (Phase 5)
}

enum SignalStatus {
  PENDING
  ACCEPTED
  DECLINED
  WITHDRAWN
}

model Signal {
  id            String       @id @default(cuid())
  kind          SignalKind
  status        SignalStatus @default(PENDING)
  fromUserId    String
  fromUser      User         @relation("SignalFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId      String // the person who decides
  toUser        User         @relation("SignalTo", fields: [toUserId], references: [id], onDelete: Cascade)
  hubId         String?
  hub           Hub?         @relation(fields: [hubId], references: [id], onDelete: Cascade)
  roleOpeningId String?
  roleOpening   RoleOpening? @relation(fields: [roleOpeningId], references: [id], onDelete: SetNull)
  planStepId    String?
  planStep      PlanStep?    @relation(fields: [planStepId], references: [id], onDelete: SetNull)
  partnerId     String? // PARTNER_INTRO: which firm
  partner       Partner?     @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  note          String // the sender's message
  respondedAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([toUserId, status])
  @@index([fromUserId, status])
  @@index([hubId, kind])
}

// ─────────────────────────────────────────────────────────────
// Partner directory (Phase 5). Firms that help builders: legal,
// suppliers, build studios, marketing, go-to-market and more.
// ─────────────────────────────────────────────────────────────

enum PartnerCategory {
  SUPPLIER // suppliers & manufacturing
  LEGAL
  WEBSITE // website & build
  MARKETING
  GTM // go-to-market
  DESIGN
  FINANCE // finance & accounting
  OTHER
}

model Partner {
  id           String            @id @default(cuid())
  slug         String            @unique
  name         String
  tagline      String
  description  String
  categories   PartnerCategory[]
  services     String[] // what they actually do, short phrases
  stages       PlanStage[] // stages they're best at
  location     String
  priceNote    String? // "Fixed-fee formation from €900". Services only.
  website      String?
  /// The firm's intro address. Revealed to a builder only after an intro is accepted.
  contactEmail String
  featured     Boolean           @default(false)
  /// The PARTNER user who manages this profile and answers intros. Unclaimed
  /// partners are handled by SELF's concierge (an admin), who makes the intro.
  claimedById  String?           @unique
  claimedBy    User?             @relation(fields: [claimedById], references: [id], onDelete: SetNull)
  signals      Signal[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([featured])
}

// ─────────────────────────────────────────────────────────────
// Marketing + GTM workspace (Phase 8). One per hub. Agents propose
// drafts; only the builder's explicit "use this" or save writes here.
// ─────────────────────────────────────────────────────────────

model GtmWorkspace {
  id          String   @id @default(cuid())
  hubId       String   @unique
  hub         Hub      @relation(fields: [hubId], references: [id], onDelete: Cascade)
  positioning String?
  customers   String? // target customers
  channels    String?
  launchPlan  String?
  updatedAt   DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────
// Team simulations (Phase 9). AI stand-ins built from each person's persona
// talk through a scenario. Always labelled SIMULATION. The fit report is a
// conversation starter: aligned / clashed / talk about this. No scores.
// ─────────────────────────────────────────────────────────────

enum SimulationStatus {
  RUNNING
  DONE
  CANCELLED // stopped early, e.g. someone withdrew consent
}

model Simulation {
  id            String                  @id @default(cuid())
  createdById   String
  createdBy     User                    @relation("SimulationsStarted", fields: [createdById], references: [id], onDelete: Cascade)
  hubId         String? // optional context
  hub           Hub?                    @relation(fields: [hubId], references: [id], onDelete: SetNull)
  scenarioKey   String // preset key or "custom"
  scenarioTitle String
  scenarioBrief String
  status        SimulationStatus        @default(RUNNING)
  maxTurns      Int
  turnCount     Int                     @default(0)
  demo          Boolean                 @default(false) // ran on demo agents
  cancelReason  String?
  participants  SimulationParticipant[]
  turns         SimulationTurn[]
  report        FitReport?
  createdAt     DateTime                @default(now())
  finishedAt    DateTime?

  @@index([createdById, createdAt])
}

model SimulationParticipant {
  id              String           @id @default(cuid())
  simulationId    String
  simulation      Simulation       @relation(fields: [simulationId], references: [id], onDelete: Cascade)
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  order           Int // speaking order
  personaSnapshot String // frozen at start: what this agent was given
  consentAt       DateTime // the opt-in in force when the simulation started
  turns           SimulationTurn[]

  @@unique([simulationId, userId])
  @@index([userId])
}

model SimulationTurn {
  id            String                @id @default(cuid())
  simulationId  String
  simulation    Simulation            @relation(fields: [simulationId], references: [id], onDelete: Cascade)
  index         Int
  participantId String
  participant   SimulationParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  text          String
  createdAt     DateTime              @default(now())

  @@unique([simulationId, index]) // one turn per slot, even if two tabs race
}

/// A conversation starter, never a score or verdict on a real person.
model FitReport {
  id           String     @id @default(cuid())
  simulationId String     @unique
  simulation   Simulation @relation(fields: [simulationId], references: [id], onDelete: Cascade)
  aligned      String[]
  clashed      String[]
  talkAbout    String[] // questions for the real people
  createdAt    DateTime   @default(now())
}

// ─────────────────────────────────────────────────────────────
// INVESTING SEAM (not built, on purpose).
//
// SELF does not move money, take investments, or run offerings. Funding is
// BACKER_INTEREST signals and introductions only. If SELF ever supports
// investing, it must sit behind a licensed funding portal or broker-dealer
// partner, and would add models roughly like:
//
//   Offering    hubId, partnerPlatform, externalOfferingId, status,
//               regulatory exemption, disclosures (owned by the platform)
//   Commitment  offeringId, backerId, externalCommitmentId, status
//               (amounts live on the licensed platform, not here)
//
// linked from Hub and from the BACKER_INTEREST Signal that started the
// relationship. Until then: no amount, valuation, terms or "commit" fields,
// anywhere. See src/lib/no-terms.ts for the guard on free text.
// ─────────────────────────────────────────────────────────────
