// SELF 2 data model: workspaces, pages and databases, plus the network.
// Plain-language guide: CLAUDE.md → "Core objects".

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// Identity (owned by Better Auth: keep these field names as-is)
// ─────────────────────────────────────────────────────────────

model User {
  id                 String                  @id @default(cuid())
  name               String
  email              String                  @unique
  emailVerified      Boolean                 @default(false)
  image              String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  sessions           Session[]
  accounts           Account[]
  profile            Profile?
  memberships        WorkspaceMember[]
  workspacesCreated  Workspace[]             @relation("WorkspaceCreatedBy")
  invitesSent        Invite[]
  pagesCreated       Page[]                  @relation("PageCreatedBy")
  pageVersions       PageVersion[]
  comments           Comment[]
  notifications      Notification[]          @relation("NotificationFor")
  notificationsSent  Notification[]          @relation("NotificationActor")
  activities         Activity[]
  agentThreads       AgentThread[]
  agentRuns          AgentRun[]
  signalsSent        Signal[]                @relation("SignalFrom")
  signalsReceived    Signal[]                @relation("SignalTo")
  partner            Partner?
  simulationsStarted Simulation[]            @relation("SimulationsStarted")
  simulationSeats    SimulationParticipant[]
  presence           PagePresence[]
  conversations      ConversationMember[]
  directMessages     DirectMessage[]
  matchNotes         MatchNote[]
  application        Application?
  invitesMade        InviteCode[]            @relation("InviteMadeBy")
  inviteUsed         InviteCode?             @relation("InviteUsedBy")
  circleSeat         CircleMember?
  circleMessages     CircleMessage[]
  journal            JournalMessage[]
  hosting            Opportunity[]
  opportunityAsks    OpportunityRequest[]
  updates            FounderUpdate[]
  following          Follow[]                @relation("FollowBacker")
  followers          Follow[]                @relation("FollowFounder")

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ─────────────────────────────────────────────────────────────
// The SELF person. One per user. Auth tables stay about login;
// everything about who someone is lives here.
// ─────────────────────────────────────────────────────────────

enum Role {
  BUILDER
  BACKER
  PARTNER
  MENTOR
  ADMIN
}

model Profile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  roles    Role[]
  headline String? // one line: "Ex-supply-chain lead building in food waste"
  location String?

  // Builder reflection. Powers the personal agent (Phase 9).
  beliefs        String? // what they believe that most people don't
  workStyle      String? // how they work when it's going well
  buildingToward String? // the long arc, not the product
  strengths      String?
  gaps           String? // where they need other people
  decisionStyle  String? // how they make hard calls

  // Mentor / backer / partner specifics (short, optional).
  focusAreas String[] // mentor + backer focus, e.g. ["Climate", "Hardware"]
  mentorNote String?
  mentorOpen Boolean  @default(true) // mentor is taking new requests

  // Personal agent (Phase 9). `persona` is exactly what the agent is given;
  // the person can always read and edit it. Simulations need explicit opt-in.
  persona          String? // Self2 free-text persona; Self3 uses selfDoc when present
  personaUpdatedAt DateTime?
  /// Your Self (Self3): short lines you can read and edit, plus "Is this you?"
  /// suggestions. Shape and rules: src/lib/self-doc.ts. The agent is given
  /// exactly the rendered lines, never pending suggestions.
  selfDoc          Json?

  // Matching (Self3). Off by default. When on, founders looking for someone
  // like you see your name, headline, location, strengths, what you're
  // building toward and this note, and SELF explains in words where you might fit.
  openToMatches     Boolean   @default(false)
  openToMatchesAt   DateTime?
  openToMatchesNote String? // "Brand and story, part-time until something is paid"

  /// The SELF app is invite-only while it's small (stage 1). NONE: signed in,
  /// no access yet · APPLIED: waiting for review · MEMBER: in.
  access         AccessStatus @default(NONE)
  /// What they build in and how far along: used only to match circles.
  buildField     String? // FOOD, CLIMATE, HEALTH, MONEY, SOFTWARE, CONSUMER, HARDWARE, OTHER (app-rules FIELDS)
  buildStage     String? // IDEA, BUILDING, FIRST_CUSTOMERS, GROWING (app-rules STAGES)
  /// Founder chose to let backers on SELF see their shared updates. Off by default.
  openToBackers  Boolean      @default(false)
  simOptIn       Boolean      @default(false)
  simOptInAt     DateTime?
  backerNote     String? // what they back. Never amounts or terms.
  partnerOrgName String? // linked to a Partner record in Phase 5

  // Contact details. Only ever revealed through an ACCEPTED Signal
  // (Phase 4+). Never select these fields for general UI.
  contactEmail String?
  contactLink  String?

  onboardingStep Int       @default(0) // resume point for the flow
  onboardedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// ─────────────────────────────────────────────────────────────
// Workspaces: one company or idea each. Every person also gets a
// PERSONAL workspace for private pages.
// ─────────────────────────────────────────────────────────────

enum AccessStatus {
  NONE
  APPLIED
  MEMBER
}

enum WorkspaceKind {
  PERSONAL
  TEAM
}

enum WorkspaceRole {
  OWNER // everything, including deleting the workspace
  ADMIN // manage members and settings
  MEMBER // create and edit pages
  GUEST // read, and comment
}

enum WorkspaceStage {
  IDEA // raw idea, no thesis yet
  THESIS // thesis written
  PLAN // game plan exists
  BUILDING
  LAUNCHED
}

model Workspace {
  id            String         @id @default(cuid())
  slug          String         @unique
  kind          WorkspaceKind  @default(TEAM)
  name          String
  icon          String? // a character or emoji the owner picked
  oneLiner      String?
  rawIdea       String? // the thought it started from
  stage         WorkspaceStage @default(IDEA)
  sector        String? // one of FOCUS_AREAS, for backer filters
  coverImageUrl String?

  // Backer discovery. Off by default; interest only, never amounts or terms.
  discoverable   Boolean   @default(false)
  discoverableAt DateTime?
  backerAsk      String?

  // Admin curation: featured workspaces lead the public lists.
  featured   Boolean   @default(false)
  featuredAt DateTime?

  createdById String
  createdBy   User     @relation("WorkspaceCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members       WorkspaceMember[]
  invites       Invite[]
  pages         Page[]
  signals       Signal[]
  agentThreads  AgentThread[]
  agentRuns     AgentRun[]
  simulations   Simulation[]
  activities    Activity[]
  conversations Conversation[]
  matchNotes    MatchNote[]
  notifications Notification[]

  @@index([kind, discoverable])
  @@index([featured])
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        WorkspaceRole @default(MEMBER)
  title       String? // "Co-founder, operations"
  joinedAt    DateTime      @default(now())

  @@unique([workspaceId, userId])
  @@index([userId])
}

model Invite {
  id          String        @id @default(cuid())
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email       String
  role        WorkspaceRole @default(MEMBER)
  token       String        @unique
  invitedById String
  invitedBy   User          @relation(fields: [invitedById], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now())
  expiresAt   DateTime
  acceptedAt  DateTime?

  @@index([workspaceId, email])
}

// ─────────────────────────────────────────────────────────────
// Pages: everything is a page. Pages nest; a DATABASE page holds
// typed rows, and each ROW is itself a page with property values.
// ─────────────────────────────────────────────────────────────

enum PageKind {
  PAGE
  DATABASE
  ROW
}

model Page {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parentId    String? // parent page; for a ROW, its database
  parent      Page?     @relation("PageTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    Page[]    @relation("PageTree")
  kind        PageKind  @default(PAGE)
  title       String    @default("")
  icon        String?
  coverUrl    String?
  content     Json? // BlockNote blocks
  text        String    @default("") // plain text of content, for search
  position    Float     @default(0) // order among siblings

  /// DATABASE: property definitions (see src/lib/db-schema.ts).
  schema    Json?
  /// ROW: property values, keyed by property id.
  props     Json?
  /// Built-in databases and pages: "gamePlan", "tasks", "roles", "meetings", "goals", "crm", "thesis", "gtm"…
  systemKey String?
  /// Template this page was made from, if any.
  template  String?
  fullWidth Boolean @default(false)

  createdById  String
  createdBy    User      @relation("PageCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  updatedById  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  archivedAt   DateTime? // in the trash
  archivedById String?

  views         DatabaseView[]
  versions      PageVersion[]
  comments      Comment[]
  signals       Signal[]
  agentThreads  AgentThread[]
  notifications Notification[]
  activities    Activity[]

  // Live co-editing (Phase 11). The Yjs document is the stored updates for the
  // current epoch; `content` stays the JSON snapshot everything else reads.
  // Server-side rewrites of `content` (restore, thesis save) bump the epoch.
  collabEpoch  Int            @default(0)
  collabSeeded Boolean        @default(false)
  updates      PageUpdate[]
  presence     PagePresence[]

  @@unique([workspaceId, systemKey])
  @@index([workspaceId, parentId, position])
  @@index([parentId, kind])
}

enum ViewType {
  TABLE
  BOARD
  LIST
  CALENDAR
}

/// A saved way of looking at a database: layout, filters, sorts, grouping.
model DatabaseView {
  id         String   @id @default(cuid())
  databaseId String
  database   Page     @relation(fields: [databaseId], references: [id], onDelete: Cascade)
  name       String
  type       ViewType @default(TABLE)
  config     Json // see src/lib/db-schema.ts ViewConfig
  position   Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([databaseId, position])
}

/// Snapshot of a page, for version history.
/// One Yjs update for a page's live document (Phase 11). Clients pull the ones
/// after the last id they've seen; compaction replaces old rows with one state.
model PageUpdate {
  id        Int      @id @default(autoincrement())
  pageId    String
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  epoch     Int
  update    Bytes
  clientId  String
  createdAt DateTime @default(now())

  @@index([pageId, epoch, id])
}

/// Who's on a page right now: their Yjs awareness state (cursor, name,
/// colour), refreshed on every poll. Rows older than a few seconds are ignored.
model PagePresence {
  pageId    String
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  clientId  String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  state     Bytes
  updatedAt DateTime @updatedAt

  @@id([pageId, clientId])
  @@index([pageId, updatedAt])
}

model PageVersion {
  id          String   @id @default(cuid())
  pageId      String
  page        Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  title       String
  content     Json?
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([pageId, createdAt])
}

// ─────────────────────────────────────────────────────────────
// Comments, notifications and activity.
// ─────────────────────────────────────────────────────────────

model Comment {
  id         String    @id @default(cuid())
  pageId     String
  page       Page      @relation(fields: [pageId], references: [id], onDelete: Cascade)
  blockId    String? // anchored to a block, or the page as a whole
  quote      String? // the text it was anchored to
  parentId   String? // replies
  parent     Comment?  @relation("Thread", fields: [parentId], references: [id], onDelete: Cascade)
  replies    Comment[] @relation("Thread")
  authorId   String
  author     User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body       String
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  notifications Notification[]

  @@index([pageId, createdAt])
}

enum NotificationKind {
  MENTION
  COMMENT
  ASSIGNED
  INVITE
  SIGNAL // a new request
  SIGNAL_ANSWERED // your request was answered
  SIMULATION
  SYSTEM
}

model Notification {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation("NotificationFor", fields: [userId], references: [id], onDelete: Cascade)
  kind        NotificationKind
  actorId     String?
  actor       User?            @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  workspaceId String?
  workspace   Workspace?       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  pageId      String?
  page        Page?            @relation(fields: [pageId], references: [id], onDelete: Cascade)
  commentId   String?
  comment     Comment?         @relation(fields: [commentId], references: [id], onDelete: Cascade)
  signalId    String?
  signal      Signal?          @relation(fields: [signalId], references: [id], onDelete: Cascade)
  text        String // one line, already written for the reader
  href        String
  readAt      DateTime?
  createdAt   DateTime         @default(now())

  @@index([userId, readAt, createdAt])
}

/// What happened in a workspace, for the weekly summary and history.
model Activity {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actorId     String
  actor       User      @relation(fields: [actorId], references: [id], onDelete: Cascade)
  kind        String // "page.created", "row.done", "member.joined", …
  pageId      String?
  page        Page?     @relation(fields: [pageId], references: [id], onDelete: SetNull)
  data        Json?
  createdAt   DateTime  @default(now())

  @@index([workspaceId, createdAt])
}

// ─────────────────────────────────────────────────────────────
// Agents: conversations and one usage row per model call.
// ─────────────────────────────────────────────────────────────

model AgentThread {
  id          String         @id @default(cuid())
  kind        String // "thesis", "agent:strategy", "page", …
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String?
  workspace   Workspace?     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  pageId      String?
  page        Page?          @relation(fields: [pageId], references: [id], onDelete: Cascade)
  messages    AgentMessage[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([workspaceId, kind])
  @@index([userId, kind])
}

enum MessageRole {
  USER
  AGENT
}

model AgentMessage {
  id        String      @id @default(cuid())
  threadId  String
  thread    AgentThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  role      MessageRole
  text      String // human-readable version
  data      Json? // structured output, when the agent returned some
  createdAt DateTime    @default(now())

  @@index([threadId, createdAt])
}

enum RunStatus {
  OK
  DEMO // no API key: canned output, no cost
  CAPPED // refused before calling: over the daily cap
  REFUSED // model declined
  ERROR
}

/// One row per agent call. Drives cost caps and the admin cost view.
model AgentRun {
  id               String     @id @default(cuid())
  userId           String
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId      String?
  workspace        Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  purpose          String // e.g. "thesis.questions"
  model            String
  status           RunStatus
  inputTokens      Int        @default(0)
  outputTokens     Int        @default(0)
  cacheReadTokens  Int        @default(0)
  cacheWriteTokens Int        @default(0)
  durationMs       Int        @default(0)
  error            String?
  createdAt        DateTime   @default(now())

  @@index([userId, createdAt])
}

enum PlanStage {
  VALIDATE
  SETUP
  BUILD
  LAUNCH
}

// ─────────────────────────────────────────────────────────────
// Signals: every "can we connect?" in SELF. See CLAUDE.md.
// Contact details are only ever revealed between the two people
// on an ACCEPTED signal (src/lib/signals.ts enforces this).
// ─────────────────────────────────────────────────────────────

enum SignalKind {
  ROLE_INTEREST // builder → workspace owner, about a role (a Roles row)
  BACKER_INTEREST // backer → workspace owner. Interest only, never money
  MENTOR_REQUEST // workspace owner → mentor
  PARTNER_INTRO // workspace owner → partner
  ROLE_INVITE // workspace member → a builder who is open to matches: "talk about this role?" (Self3)
}

enum SignalStatus {
  PENDING
  ACCEPTED
  DECLINED
  WITHDRAWN
}

model Signal {
  id            String         @id @default(cuid())
  kind          SignalKind
  status        SignalStatus   @default(PENDING)
  fromUserId    String
  fromUser      User           @relation("SignalFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId      String // the person who decides
  toUser        User           @relation("SignalTo", fields: [toUserId], references: [id], onDelete: Cascade)
  workspaceId   String?
  workspace     Workspace?     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// The row it's about: a role (ROLE_INTEREST) or a game-plan step (intros, mentor asks).
  pageId        String?
  page          Page?          @relation(fields: [pageId], references: [id], onDelete: SetNull)
  partnerId     String? // PARTNER_INTRO: which firm
  partner       Partner?       @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  note          String // the sender's message
  respondedAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  notifications Notification[]

  @@index([toUserId, status])
  @@index([fromUserId, status])
  @@index([workspaceId, kind])
}

// ─────────────────────────────────────────────────────────────
// Partner directory (Phase 5). Firms that help builders: legal,
// suppliers, build studios, marketing, go-to-market and more.
// ─────────────────────────────────────────────────────────────

enum PartnerCategory {
  SUPPLIER // suppliers & manufacturing
  LEGAL
  WEBSITE // website & build
  MARKETING
  GTM // go-to-market
  DESIGN
  FINANCE // finance & accounting
  OTHER
}

model Partner {
  id           String            @id @default(cuid())
  slug         String            @unique
  name         String
  tagline      String
  description  String
  categories   PartnerCategory[]
  services     String[] // what they actually do, short phrases
  stages       PlanStage[] // plan stages they're best at
  location     String
  priceNote    String? // "Fixed-fee formation from €900". Services only.
  website      String?
  /// The firm's intro address. Revealed to a builder only after an intro is accepted.
  contactEmail String
  featured     Boolean           @default(false)
  /// The PARTNER user who manages this profile and answers intros. Unclaimed
  /// partners are handled by SELF's concierge (an admin), who makes the intro.
  claimedById  String?           @unique
  claimedBy    User?             @relation(fields: [claimedById], references: [id], onDelete: SetNull)
  signals      Signal[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([featured])
}

// ─────────────────────────────────────────────────────────────
// Team simulations (Phase 9). AI stand-ins built from each person's persona
// talk through a scenario. Always labelled SIMULATION. The fit report is a
// conversation starter: aligned / clashed / talk about this. No scores.
// ─────────────────────────────────────────────────────────────

enum SimulationStatus {
  RUNNING
  DONE
  CANCELLED // stopped early, e.g. someone withdrew consent
}

model Simulation {
  id            String                  @id @default(cuid())
  createdById   String
  createdBy     User                    @relation("SimulationsStarted", fields: [createdById], references: [id], onDelete: Cascade)
  workspaceId   String? // optional context
  workspace     Workspace?              @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  scenarioKey   String // preset key or "custom"
  scenarioTitle String
  scenarioBrief String
  status        SimulationStatus        @default(RUNNING)
  maxTurns      Int
  turnCount     Int                     @default(0)
  demo          Boolean                 @default(false) // ran on demo agents
  cancelReason  String?
  participants  SimulationParticipant[]
  turns         SimulationTurn[]
  report        FitReport?
  createdAt     DateTime                @default(now())
  finishedAt    DateTime?

  @@index([createdById, createdAt])
}

model SimulationParticipant {
  id              String           @id @default(cuid())
  simulationId    String
  simulation      Simulation       @relation(fields: [simulationId], references: [id], onDelete: Cascade)
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  order           Int // speaking order
  personaSnapshot String // frozen at start: what this agent was given
  consentAt       DateTime // the opt-in in force when the simulation started
  turns           SimulationTurn[]

  @@unique([simulationId, userId])
  @@index([userId])
}

model SimulationTurn {
  id            String                @id @default(cuid())
  simulationId  String
  simulation    Simulation            @relation(fields: [simulationId], references: [id], onDelete: Cascade)
  index         Int
  participantId String
  participant   SimulationParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  text          String
  createdAt     DateTime              @default(now())

  @@unique([simulationId, index]) // one turn per slot, even if two tabs race
}

/// A conversation starter, never a score or verdict on a real person.
model FitReport {
  id           String     @id @default(cuid())
  simulationId String     @unique
  simulation   Simulation @relation(fields: [simulationId], references: [id], onDelete: Cascade)
  aligned      String[]
  clashed      String[]
  talkAbout    String[] // questions for the real people
  createdAt    DateTime   @default(now())
}

// ─────────────────────────────────────────────────────────────
// INVESTING SEAM (not built, on purpose).
//
// SELF does not move money, take investments, or run offerings. Funding is
// BACKER_INTEREST signals and introductions only. If SELF ever supports
// investing, it must sit behind a licensed funding portal or broker-dealer
// partner, and would add models roughly like:
//
//   Offering    workspaceId, partnerPlatform, externalOfferingId, status,
//               regulatory exemption, disclosures (owned by the platform)
//   Commitment  offeringId, backerId, externalCommitmentId, status
//               (amounts live on the licensed platform, not here)
//
// linked from Workspace and from the BACKER_INTEREST Signal that started the
// relationship. Until then: no amount, valuation, terms or "commit" fields,
// anywhere. See src/lib/no-terms.ts for the guard on free text.
// ─────────────────────────────────────────────────────────────

// ─────────────────────────────────────────────────────────────
// Messages (Self3). One conversation per pair of people, allowed only when
// they share a TEAM workspace or an ACCEPTED signal (src/lib/messages.ts).
// A trial week is proposed as a message; accepting it adds the person to
// the company as a member.
// ─────────────────────────────────────────────────────────────

model Conversation {
  id          String               @id @default(cuid())
  /// The two user ids, sorted and joined with ":". One conversation per pair.
  pairKey     String               @unique
  /// The company it started about, if any (shown as context).
  workspaceId String?
  workspace   Workspace?           @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  members     ConversationMember[]
  messages    DirectMessage[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
}

model ConversationMember {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime?

  @@unique([conversationId, userId])
  @@index([userId])
}

enum DirectMessageKind {
  TEXT
  TRIAL_PROPOSAL // data: { workspaceId, workspaceName, roleId?, title, focus, status, answeredAt? }
  NOTE // quiet system line ("Joana joined Tidewater Kelp")
}

model DirectMessage {
  id             String            @id @default(cuid())
  conversationId String
  conversation   Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  authorId       String
  author         User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  kind           DirectMessageKind @default(TEXT)
  text           String
  data           Json?
  createdAt      DateTime          @default(now())

  @@index([conversationId, createdAt])
}

/// Why SELF thinks someone might fit an open chair, in words. Never a score.
/// Cached so the explanation isn't regenerated on every visit.
model MatchNote {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String // the person who might fit
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  chairKey    String // "role:<rowId>", "need:COFOUNDER" or "need:MENTOR"
  fit         String[]
  askAbout    String[]
  demo        Boolean   @default(false)
  createdAt   DateTime  @default(now())

  @@unique([workspaceId, userId, chairKey])
}

// ─────────────────────────────────────────────────────────────
// The SELF app, stage 1. Invite-only access (commitment and fit, never
// price or pedigree), a private daily journal, matched circles that work
// like a quiet group chat, and mentors you ask directly.
// ─────────────────────────────────────────────────────────────

enum ApplicationStatus {
  PENDING
  APPROVED
  DECLINED
}

model Application {
  id         String            @id @default(cuid())
  userId     String            @unique
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  building   String // "What are you building?"
  lastWeek   String // "What did you do on it last week?"
  status     ApplicationStatus @default(PENDING)
  createdAt  DateTime          @default(now())
  reviewedAt DateTime?
}

/// One code, one person. Members get a few to share.
model InviteCode {
  id          String    @id @default(cuid())
  code        String    @unique
  createdById String
  createdBy   User      @relation("InviteMadeBy", fields: [createdById], references: [id], onDelete: Cascade)
  usedById    String?   @unique
  usedBy      User?     @relation("InviteUsedBy", fields: [usedById], references: [id], onDelete: SetNull)
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
}

model Circle {
  id        String          @id @default(cuid())
  name      String // "Food founders · first customers": what members share
  field     String?
  stage     String?
  members   CircleMember[]
  messages  CircleMessage[]
  summaries CircleSummary[]
  createdAt DateTime        @default(now())
}

model CircleMember {
  id         String   @id @default(cuid())
  circleId   String
  circle     Circle   @relation(fields: [circleId], references: [id], onDelete: Cascade)
  userId     String   @unique // one circle each, for now
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt   DateTime @default(now())
  lastReadAt DateTime @default(now())

  @@index([circleId])
}

/// SELF's short summary of a circle's week ("Catch me up"). Written by AI, labelled as such.
model CircleSummary {
  id        String   @id @default(cuid())
  circleId  String
  circle    Circle   @relation(fields: [circleId], references: [id], onDelete: Cascade)
  weekOf    DateTime @db.Date
  text      String
  /// Who could help whom: [{ from, to, why }] (first names, from the week's messages)
  helps     Json?
  demo      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([circleId, weekOf])
}

/// A short slot a mentor offers. Booked against a real problem, with context.

/// A circle is a quiet group chat. SELF posts one optional prompt a week
/// (authorId null, weekOf set); everything else is members talking.
model CircleMessage {
  id          String    @id @default(cuid())
  circleId    String
  circle      Circle    @relation(fields: [circleId], references: [id], onDelete: Cascade)
  authorId    String?
  author      User?     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  text        String
  weekOf      DateTime? @db.Date // set on SELF's weekly prompt only
  /// Shared from the author's journal (the journal entry stays private).
  fromJournal Boolean   @default(false)
  createdAt   DateTime  @default(now())

  @@unique([circleId, weekOf])
  @@index([circleId, createdAt])
}

enum JournalRole {
  ME
  SELF
}

/// The founder's daily journal. Private: only its owner can ever read it.
/// No other person, admin screen or agent (except the journal agent, for
/// that same person) reads these rows.
model JournalMessage {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      JournalRole
  text      String
  day       DateTime    @db.Date // the person's day it belongs to (UTC date)
  spoken    Boolean     @default(false) // said out loud, turned into text on the phone
  demo      Boolean     @default(false) // a demo-mode reply from SELF
  sharedAt  DateTime? // when the person shared it with their circle
  createdAt DateTime    @default(now())

  @@index([userId, day])
}

// ─────────────────────────────────────────────────────────────
// The SELF app, stage 2+: opportunities, capital (interest only).
// ─────────────────────────────────────────────────────────────

enum OpportunityKind {
  DINNER
  TRIP
  WORKSHOP
  EVENT
  INTRO_DAY
}

/// Something a host offers a few members: a dinner, a trip, a workshop, a
/// seat at an event. Selective, never pay-to-play; SELF takes no payments
/// (hosts cover costs, or people pay through an outside link).
model Opportunity {
  id           String               @id @default(cuid())
  hostId       String
  host         User                 @relation(fields: [hostId], references: [id], onDelete: Cascade)
  kind         OpportunityKind
  title        String
  description  String
  place        String // "Lisbon" · "Online"
  startsAt     DateTime
  seats        Int
  /// Who it's for, in words ("Food founders finding first customers").
  forWho       String
  fields       String[] // empty = any field (app-rules FIELDS)
  stages       String[] // empty = any stage (app-rules STAGES)
  /// Only for people who've been building lately (journal or circle, last 14 days).
  buildingOnly Boolean              @default(false)
  /// What it costs and who pays, in words. SELF never takes the money.
  costNote     String?
  closedAt     DateTime? // host stopped taking requests
  requests     OpportunityRequest[]
  createdAt    DateTime             @default(now())

  @@index([startsAt])
}

enum OpportunityRequestStatus {
  PENDING
  PICKED
  NOT_THIS_TIME
  WITHDRAWN
}

/// "I'd like to come": one line on why. The host picks.
model OpportunityRequest {
  id            String                   @id @default(cuid())
  opportunityId String
  opportunity   Opportunity              @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  userId        String
  user          User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  why           String
  status        OpportunityRequestStatus @default(PENDING)
  answeredAt    DateTime?
  createdAt     DateTime                 @default(now())

  @@unique([opportunityId, userId])
  @@index([userId])
}

/// A progress update a founder chooses to share with backers (never the
/// journal). Checked with mentionsTerms(): no amounts, valuations or terms.
model FounderUpdate {
  id        String   @id @default(cuid())
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime @default(now())

  @@index([authorId, createdAt])
}

/// A backer following a founder's shared updates. Following is not interest:
/// interest is a BACKER_INTEREST signal the founder answers.
model Follow {
  id        String   @id @default(cuid())
  backerId  String
  backer    User     @relation("FollowBacker", fields: [backerId], references: [id], onDelete: Cascade)
  founderId String
  founder   User     @relation("FollowFounder", fields: [founderId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([backerId, founderId])
  @@index([founderId])
}
