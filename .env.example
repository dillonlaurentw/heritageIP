# Local Postgres (docker compose up -d)
DATABASE_URL="postgresql://self:self@localhost:5432/self"

# Better Auth. Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-me"
BETTER_AUTH_URL="http://localhost:3000"

# Optional: Google sign-in
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional: real email via Resend. Without it, magic links are shown on screen in dev.
RESEND_API_KEY=""
EMAIL_FROM="SELF <hello@example.com>"

# Comma-separated emails that get the ADMIN role on sign-in.
ADMIN_EMAILS=""
# Who answers intros for partners that haven't claimed their profile (defaults to the first admin).
CONCIERGE_EMAIL=""

# Show "sign in as a demo user" on /sign-in. Always on in development.
DEMO_LOGIN="false"

# AI agents. Without a key, agents run in DEMO mode (canned answers, no cost).
ANTHROPIC_API_KEY=""
# Agent calls per user per day (demo runs don't count).
AGENT_DAILY_RUNS="40"

# Cover image uploads. Vercel Blob in production; local dev saves to public/uploads.
BLOB_READ_WRITE_TOKEN=""

# forself.xyz/self forwards to the SELF calibration app (Self-App repo).
# SELF_APP_ORIGIN defaults to https://self-app-iota.vercel.app. SELF_PROXY_KEY
# must match the Self-App's, so it can trust the visitor IP passed along.
SELF_APP_ORIGIN=
SELF_PROXY_KEY=

# Demo shop at /demo ("Sign in with Self"). From the Self-App review page.
SELF_DEMO_CLIENT_ID=""
SELF_DEMO_CLIENT_SECRET=""
